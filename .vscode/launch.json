{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MSVC 2026: Launch Active CMake Target (cppvsdbg)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${command:cmake.launchTargetDirectory}",
            "console": "integratedTerminal"
        },
        {
            "name": "MSVC 2026: Anti-Aliasing Demo",
            "type": "cppvsdbg",
            "request": "launch",
