{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure MSVC 2022",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "x64-msvc-2022"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build: MSVC 2022 (All)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/out/build/x64-msvc-2022",
                "--config",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build: MSVC 2022 (Anti-Aliasing)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/out/build/x64-msvc-2022",
                "--config",
                "Debug",
                "--target",
                "OpenGL_Anti_Aliasing"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}
